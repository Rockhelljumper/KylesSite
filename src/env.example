# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Kyle Simmons - Platform Engineering"

# PDF Configuration
PDF_STORAGE_PATH="./public/pdfs"

# Analytics (Optional)
NEXT_PUBLIC_ANALYTICS_ID=""

# Contact form (Resend)
# The API key and Turnstile secret belong in the server runtime only; only the
# Turnstile site key is public and must be available to the client at build time.
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Kyle Simmons <hello@example.com>"
CONTACT_RECEIVER_EMAIL="you@example.com"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_turnstile_site_key"
TURNSTILE_SECRET_KEY="your_turnstile_secret_key"

# Development
NODE_ENV="development"
